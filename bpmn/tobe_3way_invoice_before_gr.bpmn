<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_tobe" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="To-be item handling: 3-way match, invoice before GR" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Purchasing" name="Purchasing">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_req_m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_po</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_match_m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_del</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_del</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_del</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_split</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Vendor" name="Vendor">
        <bpmn:flowNodeRef>t_vi</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Warehouse" name="Warehouse">
        <bpmn:flowNodeRef>t_gr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AP" name="Accounts Payable">
        <bpmn:flowNodeRef>gw_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_tol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rpb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_tol_m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_due</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_clear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_paid</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Item needed">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="gw_req" name="Requisition raised?">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_pr" name="Create Purchase Requisition Item">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_req_m">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_po" name="Create Purchase Order Item">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_conf" name="Receive Order Confirmation">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_match" name="Price and quantity match PO?">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_fix" name="Correct PO price or quantity">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_match_m">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_del" name="Item deleted?">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_del" name="Delete Purchase Order Item">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_del" name="Item deleted">
      <bpmn:incoming>f13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="gw_split">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="t_vi" name="Vendor creates invoice">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_gr" name="Record Goods Receipt">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="gw_join">
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="t_ir" name="Record Invoice Receipt">
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_tol" name="Three-way match within tolerance?">
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_rpb" name="Resolve mismatch, Remove Payment Block">
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_tol_m">
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:outgoing>f24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="ev_due" name="Payment due date">
      <bpmn:incoming>f24</bpmn:incoming>
      <bpmn:outgoing>f25</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_due" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t_clear" name="Clear Invoice">
      <bpmn:incoming>f25</bpmn:incoming>
      <bpmn:outgoing>f26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_paid" name="Paid">
      <bpmn:incoming>f26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="gw_req" />
    <bpmn:sequenceFlow id="f2" sourceRef="gw_req" targetRef="t_pr" name="with requisition" />
    <bpmn:sequenceFlow id="f3" sourceRef="gw_req" targetRef="gw_req_m" name="direct PO" />
    <bpmn:sequenceFlow id="f4" sourceRef="t_pr" targetRef="gw_req_m" />
    <bpmn:sequenceFlow id="f5" sourceRef="gw_req_m" targetRef="t_po" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_po" targetRef="t_conf" />
    <bpmn:sequenceFlow id="f7" sourceRef="t_conf" targetRef="gw_match" />
    <bpmn:sequenceFlow id="f8" sourceRef="gw_match" targetRef="gw_match_m" name="yes" />
    <bpmn:sequenceFlow id="f9" sourceRef="gw_match" targetRef="t_fix" name="no" />
    <bpmn:sequenceFlow id="f10" sourceRef="t_fix" targetRef="gw_match_m" />
    <bpmn:sequenceFlow id="f11" sourceRef="gw_match_m" targetRef="gw_del" />
    <bpmn:sequenceFlow id="f12" sourceRef="gw_del" targetRef="t_del" name="yes" />
    <bpmn:sequenceFlow id="f13" sourceRef="t_del" targetRef="end_del" />
    <bpmn:sequenceFlow id="f14" sourceRef="gw_del" targetRef="gw_split" name="no" />
    <bpmn:sequenceFlow id="f15" sourceRef="gw_split" targetRef="t_vi" />
    <bpmn:sequenceFlow id="f16" sourceRef="gw_split" targetRef="t_gr" />
    <bpmn:sequenceFlow id="f17" sourceRef="t_vi" targetRef="gw_join" />
    <bpmn:sequenceFlow id="f18" sourceRef="t_gr" targetRef="gw_join" />
    <bpmn:sequenceFlow id="f19" sourceRef="gw_join" targetRef="t_ir" />
    <bpmn:sequenceFlow id="f20" sourceRef="t_ir" targetRef="gw_tol" />
    <bpmn:sequenceFlow id="f21" sourceRef="gw_tol" targetRef="t_rpb" name="no" />
    <bpmn:sequenceFlow id="f22" sourceRef="gw_tol" targetRef="gw_tol_m" name="yes" />
    <bpmn:sequenceFlow id="f23" sourceRef="t_rpb" targetRef="gw_tol_m" />
    <bpmn:sequenceFlow id="f24" sourceRef="gw_tol_m" targetRef="ev_due" />
    <bpmn:sequenceFlow id="f25" sourceRef="ev_due" targetRef="t_clear" />
    <bpmn:sequenceFlow id="f26" sourceRef="t_clear" targetRef="end_paid" />
    <bpmn:textAnnotation id="ann_1">
      <bpmn:text>Change 1 (S1): order confirmation is mandatory; price and quantity are fixed before goods and invoice arrive</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_1" sourceRef="t_conf" targetRef="ann_1" />
    <bpmn:textAnnotation id="ann_2">
      <bpmn:text>Change 2 (control): the invoice is booked only after the goods receipt (closes the K4 leak)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_2" sourceRef="gw_join" targetRef="ann_2" />
    <bpmn:textAnnotation id="ann_3">
      <bpmn:text>Change 3 (S2): automatic match with tolerance; only real mismatches are blocked</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_3" sourceRef="gw_tol" targetRef="ann_3" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
