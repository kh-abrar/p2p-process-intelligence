    <bpmn:sequenceFlow id="f11" sourceRef="gw_conf" targetRef="gw_conf_m" name="no" />
    <bpmn:sequenceFlow id="f12" sourceRef="t_conf" targetRef="gw_conf_m" />
    <bpmn:sequenceFlow id="f13" sourceRef="gw_conf_m" targetRef="gw_split" />
    <bpmn:sequenceFlow id="f14" sourceRef="gw_split" targetRef="t_vi" />
    <bpmn:sequenceFlow id="f15" sourceRef="gw_split" targetRef="t_gr" />
    <bpmn:sequenceFlow id="f16" sourceRef="t_vi" targetRef="t_ir" />
    <bpmn:sequenceFlow id="f17" sourceRef="t_ir" targetRef="gw_join" />
    <bpmn:sequenceFlow id="f18" sourceRef="t_gr" targetRef="gw_join" />
    <bpmn:sequenceFlow id="f19" sourceRef="gw_join" targetRef="gw_block" />
    <bpmn:sequenceFlow id="f20" sourceRef="gw_block" targetRef="t_rpb" name="yes" />
    <bpmn:sequenceFlow id="f21" sourceRef="gw_block" targetRef="gw_block_m" name="no" />
